# Copie este arquivo para .env na raiz do projeto antes de rodar o Docker:
#   cp .env.docker.example .env        (Linux/macOS)
#   copy .env.docker.example .env      (Windows CMD)
#
# O docker compose lê o .env da raiz automaticamente.

# ---------- Portas expostas no host ----------
# Altere se alguma porta já estiver ocupada na sua máquina.
FRONTEND_PORT=3000
BACKEND_PORT=3001
MONGO_PORT=27017

# ---------- MongoDB (container local) ----------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=rootpassword
MONGO_DB_NAME=oportunidades-iff

# ---------- URLs ----------
# NEXT_PUBLIC_API_URL é embutida no bundle do navegador em tempo de build.
# Deve apontar para um endereço acessível pelo SEU NAVEGADOR (o host),
# e não para o nome interno do serviço no Compose.
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ---------- JWT (obrigatório) ----------
# Gere uma chave forte, por exemplo:
#   openssl rand -base64 32
JWT_SECRET=troque-esta-chave-por-uma-aleatoria-e-forte
JWT_EXPIRES_IN=1d

# ---------- E-mail ----------
# Com "false" o cadastro já nasce verificado e nenhum SMTP é necessário.
# Ideal para desenvolvimento e para avaliar o projeto localmente.
EMAIL_VERIFICATION_ENABLED=false
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# ---------- Regras de negócio ----------
ALLOWED_EMAIL_DOMAIN=gsuite.iff.edu.br

# ---------- Admin inicial (criado pelo seed) ----------
ADMIN_SEED_EMAIL=admin@gsuite.iff.edu.br
ADMIN_SEED_PASSWORD=admin123
